							"path": ["users", "1", "watchlists"]
						}
					}
				},
				{
					"name": "Get Watchlist Quota",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/users/1/watchlist-quota",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "watchlist-quota"]
						}
					}
				},
				{
					"name": "Add Watchlist Item",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"stock_code\": \"BBCA\",\n  \"notes\": \"Target buy at support\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/1/watchlists",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "watchlists"]
						}
					}
				},
				{
					"name": "Get Watchlist Detail",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/users/1/watchlists/1",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "watchlists", "1"]
						}
					}
				},
				{
					"name": "Update Watchlist Item",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"notes\": \"Updated note context\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/1/watchlists/1",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "watchlists", "1"]
						}
					}
				},
				{
					"name": "Delete Watchlist Item",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/users/1/watchlists/1",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "watchlists", "1"]
						}
					}
				}
			]
		},
		{
			"name": "4. Market Data & Forecasting",
			"item": [
				{
					"name": "Get OHLC Data",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/data/ohlc?symbol=BBCA&period=1d&limit=300",
							"host": ["{{base_url}}"],
							"path": ["api", "data", "ohlc"],
							"query": [
								{ "key": "symbol", "value": "BBCA" },
								{ "key": "period", "value": "1d" },
								{ "key": "limit", "value": "300" }
							]
						}
					}
				},
				{
					"name": "Get Broker Activity Data",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/data/broker-activity?symbol=BBCA&date=2026-08-01",
							"host": ["{{base_url}}"],
							"path": ["api", "data", "broker-activity"],
							"query": [
								{ "key": "symbol", "value": "BBCA" },
								{ "key": "date", "value": "2026-08-01" }
							]
						}
					}
				},
				{
					"name": "Get Stock Info",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/data/stock-info?symbol=BBCA",
