							"query": [
								{ "key": "symbol", "value": "BBCA" }
							]
						}
					}
				},
				{
					"name": "Get Major Shareholders",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/data/majorholder?symbol=BBCA",
							"host": ["{{base_url}}"],
							"path": ["api", "data", "majorholder"],
							"query": [
								{ "key": "symbol", "value": "BBCA" }
							]
						}
					}
				},
				{
					"name": "Get Forecast Data",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/data/forecast?symbol=BBCA&days=7",
							"host": ["{{base_url}}"],
							"path": ["api", "data", "forecast"],
							"query": [
								{ "key": "symbol", "value": "BBCA" },
								{ "key": "days", "value": "7" }
							]
						}
					}
				}
			]
		},
		{
			"name": "5. Prescriptive Analytics",
			"item": [
				{
					"name": "Run Prescriptive Model",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"BBCA\",\n  \"risk_tolerance\": \"medium\",\n  \"horizon_days\": 14\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/prescriptive/run",
							"host": ["{{base_url}}"],
							"path": ["api", "prescriptive", "run"]
						}
					}
				},
				{
					"name": "Get Prescriptive Results",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/prescriptive/results?symbol=BBCA",
							"host": ["{{base_url}}"],
							"path": ["api", "prescriptive", "results"],
							"query": [
								{ "key": "symbol", "value": "BBCA" }
							]
						}
