							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						}
					}
				},
				{
					"name": "Get Crawl Logs",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/crawl-status?limit=50",
							"host": ["{{base_url}}"],
							"path": ["crawl-status"],
							"query": [
								{ "key": "limit", "value": "50" }
							]
						}
					}
				},
				{
					"name": "Update System Token",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"YOUR_STOCKBIT_ACCESS_TOKEN\"\n}"
